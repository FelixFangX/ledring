{
  "$schema": "ledring.tokens.v3",
  "name": "Catalogue no. 417",
  "color": {
    "bg": {"base": "#F3F2EE", "sunken": "#ECEAE4", "panel": "#FBFAF7", "raised": "#FFFFFF"},
    "line": {"1": "#E3E1DA", "2": "#CFCDC6", "3": "#16181A"},
    "text": {"1": "#16181A", "2": "#6B6E70", "3": "#8C8E8A", "4": "#A3A49F"},
    "accent": {"ink": "#16181A", "ink-tint": "rgba(22,24,26,.06)", "ink-glow": "transparent"},
    "ledring": {"calm": "#2F5BEA", "processing": "#E8B10A", "critical": "#D7261E"},
    "semantic": {"ok": "#2F7A3E", "warn": "#E8B10A", "danger": "#D7261E"},
    "diff": {"add": "#E3EADF", "remove": "#F3DEDA"}
  },
  "font": {
    "display": "Archivo, 'Helvetica Neue', Arial, sans-serif",
    "sans": "'IBM Plex Sans', 'Helvetica Neue', Arial, sans-serif",
    "mono": "'IBM Plex Mono', ui-monospace, Menlo, Consolas, monospace",
    "scale": {
      "caption": {"size": "11px", "family": "mono", "case": "lower"},
      "data": {"size": "12px", "family": "mono", "numeric": "tabular-nums"},
      "body": {"size": "14px", "lineHeight": 1.5, "family": "sans"},
      "lede": {"size": "17px", "lineHeight": 1.5, "family": "sans"},
      "module-name": {"size": "26px", "family": "display", "width": "70%", "weight": 600, "case": "upper"},
      "title": {"size": "64px", "lineHeight": 0.92, "family": "display", "width": "66%", "weight": 600, "case": "upper"},
      "index-number": {"size": "72px", "lineHeight": 0.8, "family": "display", "width": "62%", "weight": 600},
      "hero": {"size": "84px", "lineHeight": 0.86, "family": "display", "width": "64%", "weight": 600, "case": "upper"},
      "model-number": {"size": "90px", "lineHeight": 0.82, "family": "display", "width": "125%", "weight": 700, "tracking": "-0.05em"}
    }
  },
  "grid": {"columns": 12, "gutter": "24px", "margin": "48px", "index-column": "2 of 12"},
  "space": {"1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "40px", "7": "56px"},
  "radius": {"sm": "0", "md": "0"},
  "border": {"rule": "1px solid #CFCDC6", "print": "1px solid #16181A", "locked": "1px dashed #A3A49F"},
  "shadow": {"none": "none", "palette": "8px 8px 0 #16181A"},
  "motion": {
    "out": "cubic-bezier(.2,1,.3,1)",
    "path-reveal": "linear",
    "wall": "cubic-bezier(.7,0,.2,1)",
    "stamp": "cubic-bezier(.3,1.6,.5,1)",
    "rules": "Line-draw reveals, the wall slide and verdict stamps only. No fade-up on blocks. Reduced motion disables everything."
  },
  "bans": ["glass/backdrop blur", "glow", "gradient fills or text", "grain", "rounded cards", "drop shadows (except the palette offset)", "emoji", "bracketed eyebrow labels"]
}
