{
  "$schema": "ledring.tokens.v2",
  "color": {
    "bg": {"base":"#06080B","sunken":"#0A0D11","panel":"#0D1116","raised":"#121820","overlay":"rgba(14,19,25,.78)"},
    "line": {"1":"rgba(255,255,255,.07)","2":"rgba(255,255,255,.12)","3":"rgba(255,255,255,.20)","hud-dash":"rgba(255,255,255,.06)"},
    "text": {"1":"#E9EEF3","2":"#9AA6B2","3":"#5C6773","4":"#38414B"},
    "accent": {"cyan":"#5FE3F5","cyan-strong":"#2BC4DB","cyan-tint":"rgba(95,227,245,.12)","cyan-glow":"rgba(95,227,245,.35)"},
    "ledring": {"calm":"#4C9DFF","processing":"#F5C451","critical":"#FF5A5F"},
    "semantic": {"ok":"#4ADE9B","warn":"#F5C451","danger":"#FF5A5F"}
  },
  "font": {
    "sans":"Geist, Inter, system-ui, PingFang SC, Microsoft YaHei, sans-serif",
    "mono":"Geist Mono, JetBrains Mono, ui-monospace, SF Mono, Menlo, monospace",
    "scale": {
      "label":{"size":"10.5px","weight":500,"tracking":"0.09em","case":"upper","family":"mono"},
      "mono-sm":{"size":"11.5px","weight":400,"family":"mono"},
      "body":{"size":"13px","lineHeight":1.55,"tracking":"-0.003em"},
      "h3":{"size":"15px","weight":500,"tracking":"-0.012em"},
      "greet":{"size":"17px","weight":400,"tracking":"-0.01em"},
      "h2":{"size":"24px","weight":600,"tracking":"-0.025em"},
      "kpi":{"size":"26px","weight":500,"tracking":"-0.04em","family":"mono"},
      "h1":{"size":"40px","weight":600,"tracking":"-0.035em"},
      "display-num":{"size":"56px","weight":500,"tracking":"-0.05em","family":"mono"}
    },
    "numeric":"tabular-nums"
  },
  "space": {"1":"4px","2":"8px","3":"12px","4":"16px","5":"24px","6":"32px","7":"48px"},
  "radius": {"sm":"6px","md":"10px","lg":"14px","pill":"999px"},
  "border": {"hairline":"1px solid rgba(255,255,255,.07)"},
  "shadow": {
    "inner-highlight":"inset 0 1px 0 rgba(255,255,255,.045)",
    "panel":"inset 0 1px 0 rgba(255,255,255,.045), 0 1px 2px rgba(0,0,0,.4)",
    "overlay":"0 24px 80px -12px rgba(0,0,0,.7), 0 0 0 1px rgba(255,255,255,.12)",
    "focus":"0 0 0 1px #06080B, 0 0 0 3px rgba(95,227,245,.5)",
    "glow-accent":"0 6px 24px -6px rgba(95,227,245,.5)"
  },
  "effect": {
    "grain":{"type":"feTurbulence fractalNoise","baseFrequency":0.9,"octaves":3,"opacity":0.05,"blend":"overlay"},
    "light-sources":["radial 900x520 @78% -8% cyan 7.5%","radial 700x500 @8% 110% blue 5%"],
    "glass":"backdrop-filter: blur(16-24px) saturate(1.4-1.6)",
    "dot-grid":"radial 1px rgba(255,255,255,.06) every 20px"
  },
  "motion": {
    "spring":"cubic-bezier(.2,.9,.25,1.12)",
    "out":"cubic-bezier(.16,1,.3,1)",
    "path-reveal":"cubic-bezier(.65,0,.35,1)",
    "duration":{"micro":"150ms","small":"200-250ms","panel":"350-600ms","large":"700-900ms"},
    "stagger":"55ms",
    "enter":"translateY(8px) + blur(3px) -> none",
    "reducedMotion":"all animations disabled"
  }
}
