{
  "name": "@ledring/cli",
  "private": true,
  "version": "0.2.0-beta.0",
  "description": "Workspace source for the `ledring` command. The npm package is `ledring`, staged by scripts/stage-beta.mjs.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ledring": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@ledring/flowchart": "workspace:*",
    "@ledring/instability": "workspace:*",
    "@ledring/trace": "workspace:*",
    "@ledring/trust": "workspace:*",
    "@ledring/cards": "workspace:*",
    "@ledring/redwall": "workspace:*",
    "@ledring/play-bridge": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FelixFangX/ledring.git",
    "directory": "packages/cli"
  }
}
