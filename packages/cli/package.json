{
  "name": "ledring",
  "version": "0.2.0-beta.0",
  "description": "See where agent runs split, and which steps left the instruction.",
  "license": "MIT",
  "author": "Felix Fang",
  "homepage": "https://ledring.dev",
  "bugs": { "url": "https://github.com/FelixFangX/ledring/issues" },
  "keywords": ["ai", "agents", "traces", "mcp", "cli", "ledring"],
  "type": "module",
  "bin": { "ledring": "./dist/bin.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "prepack": "node scripts/bundle.mjs && node scripts/stage-license.mjs",
    "postpack": "node scripts/stage-license.mjs --remove"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@ledring/flowchart": "workspace:*",
    "@ledring/instability": "workspace:*",
    "@ledring/trace": "workspace:*",
    "@ledring/trust": "workspace:*",
    "@ledring/cards": "workspace:*",
    "@ledring/redwall": "workspace:*",
    "@ledring/play-bridge": "workspace:*",
    "esbuild": "^0.25.11"
  },
  "repository": { "type": "git", "url": "git+https://github.com/FelixFangX/ledring.git", "directory": "packages/cli" }
}
