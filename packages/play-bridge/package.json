{
  "name": "@ledring/play-bridge",
  "version": "0.2.0-beta.0",
  "description": "Local LEDRING Play bridge. Credentials stay here; the page only sees status and streams.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --root ../.. packages/play-bridge/test"
  },
  "dependencies": {
    "@ledring/play-core": "workspace:*",
    "@ledring/play-judge": "workspace:*",
    "@ledring/play-providers": "workspace:*",
    "@ledring/play-sandbox": "workspace:*",
    "zod": "^3.23.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FelixFangX/ledring.git",
    "directory": "packages/play-bridge"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
